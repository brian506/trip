#!/bin/sh
# Pre-push: last guard before commits become public.
# 1. Forbidden words in commit messages and added lines of the pushed commits
# 2. Code or build settings changed -> ./gradlew clean test (compile + unit tests). Integration tests run in CI.
#    Tests run on the working tree, so the pushed branch must be checked out.
# Code review split by change type (src/main -> review, src/test -> test-review) runs in Claude before push. See .claude/skills/push/SKILL.md.

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT" || exit 1
CHECK="$ROOT/scripts/check-forbidden-words.sh"
ZERO=0000000000000000000000000000000000000000

REVS=$(mktemp)
trap 'rm -f "$REVS"' EXIT

HEAD_REF=$(git symbolic-ref -q HEAD)
HEAD_SHA=$(git rev-parse HEAD)
NOT_CHECKED_OUT=""

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue
    if [ "$local_ref" != "$HEAD_REF" ] || [ "$local_sha" != "$HEAD_SHA" ]; then
        NOT_CHECKED_OUT="$NOT_CHECKED_OUT $local_ref"
    fi
    if [ "$remote_sha" = "$ZERO" ]; then
        git rev-list "$local_sha" --not --remotes >> "$REVS"
    else
        git rev-list "$remote_sha..$local_sha" >> "$REVS"
    fi
done

[ -s "$REVS" ] || exit 0

echo "[pre-push] 푸시할 커밋의 금지어 검사"
hit=$(sort -u "$REVS" | while read -r rev; do
    git log -1 --format=%B "$rev"
    git show --format= --no-color -U0 "$rev" | awk '/^\+\+\+ b\//{f=substr($0,7); next} /^\+/{print f": "substr($0,2)}'
done | sh "$CHECK")
case $? in
    1) echo "FAIL  푸시할 커밋에 금지어가 있다"; printf '%s\n' "$hit" | sed 's/^/      /'; exit 1 ;;
    2) exit 1 ;;
esac

code_changed=$(sort -u "$REVS" \
    | while read -r rev; do git show --name-only --format= "$rev"; done \
    | grep -E '^(src/|build\.gradle$|settings\.gradle$|gradle/|lombok\.config$)')

if [ -z "$code_changed" ]; then
    echo "[pre-push] 코드 변경 없음. 빌드 생략"
    exit 0
fi

if [ -n "$NOT_CHECKED_OUT" ]; then
    echo "FAIL  푸시할 브랜치를 체크아웃한 뒤 푸시한다. 테스트는 작업 트리 기준으로 돈다"
    echo "      대상:$NOT_CHECKED_OUT"
    exit 1
fi

echo "[pre-push] clean test (컴파일 + 단위 테스트)"
./gradlew clean test --console=plain -q || { echo "FAIL  컴파일 또는 단위 테스트 실패. 푸시를 중단한다"; exit 1; }
echo "[pre-push] 통과"
exit 0
