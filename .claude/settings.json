{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(sh scripts/*)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(java -version)",
      "Bash(curl http://localhost:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(gh issue delete *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-gh-text.sh\""
          }
        ]
      }
    ]
  }
}
